# Supabase (Project Settings → API). Crea el projecte a la regió UE (Frankfurt o París).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NOMÉS al servidor. Mai amb el prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (opcional en mode demo, obligatori en producció)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# true (per defecte): mostra la franja "Versió demo" i no indexa a Google
NEXT_PUBLIC_DEMO_MODE=true
